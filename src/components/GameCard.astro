---
interface Props {
  game: any;
  dataLabel: string;
  ora: string;
  gameLabel?: string;
}

const { game, dataLabel, ora, gameLabel = 'Partita' } = Astro.props;

// Logo NBA via CDN — mappa abbreviazione → ID NBA ufficiale
const nbaLogoId: Record<string, number> = {
  ATL: 1610612737, BOS: 1610612738, BKN: 1610612751, CHA: 1610612766,
  CHI: 1610612741, CLE: 1610612739, DAL: 1610612742, DEN: 1610612743,
  DET: 1610612765, GSW: 1610612744, HOU: 1610612745, IND: 1610612754,
  LAC: 1610612746, LAL: 1610612747, MEM: 1610612763, MIA: 1610612748,
  MIL: 1610612749, MIN: 1610612750, NOP: 1610612740, NYK: 1610612752,
  OKC: 1610612760, ORL: 1610612753, PHI: 1610612755, PHX: 1610612756,
  POR: 1610612757, SAC: 1610612758, SAS: 1610612759, TOR: 1610612761,
  UTA: 1610612762, WAS: 1610612764,
};

function logoUrl(abbr: string): string {
  const id = nbaLogoId[abbr];
  if (!id) return '';
  return `https://cdn.nba.com/logos/nba/${id}/global/L/logo.svg`;
}

const home = game.home_team;
const away = game.visitor_team;
---

<article class="shrink-0 w-56 sm:w-64 rounded-xl border border-orange-500 bg-neutral-800 flex flex-col overflow-hidden">

  <!-- Header card: data + ora -->
  <div class="flex items-center justify-between px-4 pt-4 pb-2">
    <span class="text-sm font-bold text-white uppercase tracking-wide" style="font-family:'Agdasima',sans-serif;">
      {dataLabel}
    </span>
    <span class="text-sm font-bold text-white" style="font-family:'Agdasima',sans-serif;">
      {ora}
    </span>
  </div>

  <!-- Game label (es. "Gara 1", "Playoffs") -->
  <div class="px-4 pb-3">
    <span class="text-xs text-neutral-400">{gameLabel}</span>
  </div>

  <!-- Squadre -->
  <div class="flex flex-col gap-3 px-4 pb-4 flex-1">

    <!-- Home team -->
    <div class="flex items-center gap-3">
      <div class="h-10 w-10 shrink-0 rounded-md bg-neutral-700 overflow-hidden flex items-center justify-center">
        {logoUrl(home.abbreviation) ? (
          <img
            src={logoUrl(home.abbreviation)}
            alt={home.full_name}
            class="h-8 w-8 object-contain"
            loading="lazy"
            onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
          />
        ) : null}
        <span class="text-xs font-bold text-neutral-400 hidden">{home.abbreviation}</span>
      </div>
      <span class="text-sm font-medium text-white leading-tight">{home.full_name}</span>
    </div>

    <!-- Away team -->
    <div class="flex items-center gap-3">
      <div class="h-10 w-10 shrink-0 rounded-md bg-neutral-700 overflow-hidden flex items-center justify-center">
        {logoUrl(away.abbreviation) ? (
          <img
            src={logoUrl(away.abbreviation)}
            alt={away.full_name}
            class="h-8 w-8 object-contain"
            loading="lazy"
            onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
          />
        ) : null}
        <span class="text-xs font-bold text-neutral-400 hidden">{away.abbreviation}</span>
      </div>
      <span class="text-sm font-medium text-white leading-tight">{away.full_name}</span>
    </div>
  </div>

  <!-- Footer: Dove vedere -->
  <div class="px-4 pb-4">
    <a
      href="/dove-vedere"
      class="block w-full rounded-md bg-orange-500 py-2 text-center text-sm font-bold text-white transition-colors hover:bg-orange-400"
      style="font-family:'Agdasima',sans-serif;"
    >
      Dove vedere
    </a>
  </div>

</article>
