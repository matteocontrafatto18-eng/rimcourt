---
const nav = [
  { label: 'Game', href: '/partite' },
  { label: 'Stats', href: '/statistiche' },
  { label: 'Drama', href: '/drama' },
];
const { pathname } = Astro.url;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header class="sticky top-0 z-50 bg-black border-b border-neutral-900">
  <div class="mx-auto flex max-w-3xl items-center gap-8 px-4 py-4">

    <!-- Logo + nome -->
    <a href="/" class="flex items-center gap-3 shrink-0" aria-label="Rimcourt, vai alla home">
      <img src="/logo.png" alt="Rimcourt logo" class="h-10 w-10 object-contain" />
      <span
        class="text-2xl font-bold tracking-widest uppercase text-white"
        style="font-family: 'Agdasima', sans-serif;"
      >
        RIMCOURT
      </span>
    </a>

    <!-- Nav -->
    <nav class="hidden items-center gap-7 md:flex flex-1" aria-label="Navigazione principale">
      {nav.map((item) => {
        const active = isActive(item.href);
        return (
          <a
            href={item.href}
            aria-current={active ? 'page' : undefined}
            class={`text-sm tracking-wide transition-colors hover:text-white ${active ? 'text-white' : 'text-neutral-400'}`}
            style="font-family: 'Agdasima', sans-serif;"
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <!-- Destra: ricerca + newsletter -->
    <div class="flex items-center gap-2 ml-auto">
      <!-- Bottone ricerca -->
      <button
        aria-label="Cerca"
        class="flex h-9 w-9 items-center justify-center rounded-md bg-white text-black transition-colors hover:bg-neutral-200"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <circle cx="11" cy="11" r="7"/>
          <line x1="16.5" y1="16.5" x2="22" y2="22" stroke-linecap="round"/>
        </svg>
      </button>

      <!-- Bottone newsletter -->
      <a
        href="/newsletter"
        class="rounded-md bg-white px-4 py-2 text-sm font-bold text-black transition-colors hover:bg-neutral-200"
        style="font-family: 'Agdasima', sans-serif;"
      >
        Newsletter
      </a>
    </div>

  </div>
</header>
