---
const nav = [
  { label: 'Game', href: '/partite' },
  { label: 'Stats', href: '/statistiche' },
  { label: 'Drama', href: '/drama' },
];
const { pathname } = Astro.url;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header class="sticky top-0 z-50 bg-black border-b border-neutral-900">
  <div class="mx-auto grid max-w-6xl grid-cols-3 items-center px-6 py-5">

    <!-- Sinistra: Logo + nome -->
    <a href="/" class="flex items-center gap-3" aria-label="Rimcourt, vai alla home">
      <img src="/logo.png" alt="Rimcourt logo" class="h-12 w-12 object-contain" />
      <span class="text-3xl font-bold tracking-widest uppercase text-white leading-none" style="font-family:'Agdasima',sans-serif;">
        RIMCOURT
      </span>
    </a>

    <!-- Centro: Nav -->
    <nav class="hidden md:flex items-center justify-center gap-8" aria-label="Navigazione principale">
      {nav.map((item) => {
        const active = isActive(item.href);
        return (
          <a
            href={item.href}
            aria-current={active ? 'page' : undefined}
            class={`text-lg tracking-wide transition-colors hover:text-white ${active ? 'text-white' : 'text-white/70'}`}
            style="font-family:'Agdasima',sans-serif;"
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <!-- Destra: ricerca + newsletter -->
    <div class="hidden md:flex items-center justify-end gap-3">
      <button
        aria-label="Cerca"
        class="flex h-10 w-10 items-center justify-center rounded-md bg-white text-black transition-colors hover:bg-neutral-200"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <circle cx="11" cy="11" r="7"/>
          <line x1="16.5" y1="16.5" x2="22" y2="22" stroke-linecap="round"/>
        </svg>
      </button>
      <a
        href="/newsletter"
        class="rounded-md bg-white px-5 py-2.5 text-base font-bold text-black transition-colors hover:bg-neutral-200"
        style="font-family:'Agdasima',sans-serif;"
      >
        Newsletter
      </a>
    </div>

    <!-- Mobile: hamburger (colonna 3) -->
    <div class="flex md:hidden justify-end">
      <button
        id="menu-toggle"
        aria-label="Apri menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="flex flex-col justify-center items-center gap-1.5 h-10 w-10"
      >
        <span class="hamburger-line block h-0.5 w-6 bg-white transition-all duration-300"></span>
        <span class="hamburger-line block h-0.5 w-6 bg-white transition-all duration-300"></span>
        <span class="hamburger-line block h-0.5 w-6 bg-white transition-all duration-300"></span>
      </button>
    </div>

  </div>

  <!-- Menu mobile -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-neutral-900 bg-black" aria-hidden="true">
    <nav class="flex flex-col px-6 py-4 gap-1" aria-label="Navigazione mobile">
      {nav.map((item) => {
        const active = isActive(item.href);
        return (
          <a
            href={item.href}
            aria-current={active ? 'page' : undefined}
            class={`py-3 text-xl tracking-wide border-b border-neutral-900 transition-colors hover:text-white ${active ? 'text-white' : 'text-white/70'}`}
            style="font-family:'Agdasima',sans-serif;"
          >
            {item.label}
          </a>
        );
      })}
      <a
        href="/newsletter"
        class="mt-4 rounded-md bg-white px-5 py-3 text-center text-lg font-bold text-black"
        style="font-family:'Agdasima',sans-serif;"
      >
        Newsletter
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle')!;
  const menu = document.getElementById('mobile-menu')!;

  toggle.addEventListener('click', () => {
    const isOpen = !menu.classList.contains('hidden');
    menu.classList.toggle('hidden', isOpen);
    menu.setAttribute('aria-hidden', String(isOpen));
    toggle.setAttribute('aria-expanded', String(!isOpen));
    toggle.setAttribute('aria-label', isOpen ? 'Apri menu' : 'Chiudi menu');

    const lines = toggle.querySelectorAll<HTMLElement>('.hamburger-line');
    lines[0].style.transform = isOpen ? '' : 'translateY(8px) rotate(45deg)';
    lines[1].style.opacity = isOpen ? '1' : '0';
    lines[2].style.transform = isOpen ? '' : 'translateY(-8px) rotate(-45deg)';
  });

  menu.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      menu.setAttribute('aria-hidden', 'true');
      toggle.setAttribute('aria-expanded', 'false');
      const lines = toggle.querySelectorAll<HTMLElement>('.hamburger-line');
      lines[0].style.transform = '';
      lines[1].style.opacity = '1';
      lines[2].style.transform = '';
    });
  });
</script>
