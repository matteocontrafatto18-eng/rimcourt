---
const nav = [
  { label: 'Game', href: '/game' },
  { label: 'Stats', href: '/stats' },
  { label: 'Drama', href: '/drama' },
];
const { pathname } = Astro.url;
---

<header class="header">
  <div class="header-inner">
    <a href="/" class="brand">
      <img src="/logo.png" alt="Rimcourt" class="brand-logo" />
      <span class="brand-name">RIMCOURT</span>
    </a>
    <nav class="nav-desktop" aria-label="Navigazione principale">
      {nav.map(({ label, href }) => (
        <a href={href} class={pathname.startsWith(href) ? 'active' : ''}>{label}</a>
      ))}
    </nav>
    <div class="nav-actions">
      <button class="btn-search" aria-label="Cerca">
        <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <circle cx="11" cy="11" r="7"/>
          <line x1="16.5" y1="16.5" x2="22" y2="22" stroke-linecap="round"/>
        </svg>
      </button>
      <a href="/newsletter" class="btn-newsletter">Newsletter</a>
    </div>
    <button class="btn-hamburger" id="hamburger" aria-label="Apri menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
  <nav class="nav-mobile" id="mobile-menu" aria-hidden="true">
    {nav.map(({ label, href }) => (
      <a href={href}>{label}</a>
    ))}
    <a href="/newsletter" class="btn-newsletter">Newsletter</a>
  </nav>
</header>

<script>
  const btn = document.getElementById('hamburger')!;
  const menu = document.getElementById('mobile-menu')!;
  btn.addEventListener('click', () => {
    const open = menu.classList.toggle('open');
    btn.setAttribute('aria-expanded', String(open));
    menu.setAttribute('aria-hidden', String(!open));
  });
</script>

<style>
  .header { position: sticky; top: 0; z-index: 100; background: #000; border-bottom: 1px solid #1a1a1a; font-family: 'Agdasima', sans-serif; }
  .header-inner { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; height: 72px; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 2rem; }
  .brand { display: flex; align-items: center; gap: 0.75rem; text-decoration: none; }
  .brand-logo { height: 44px; width: 44px; object-fit: contain; }
  .brand-name { font-size: 1.6rem; font-weight: 700; letter-spacing: 0.15em; color: #fff; }
  .nav-desktop { display: flex; align-items: center; justify-content: center; gap: 2.5rem; }
  .nav-desktop a { color: #fff; text-decoration: none; font-size: 1.1rem; letter-spacing: 0.05em; opacity: 0.8; transition: opacity 0.2s; }
  .nav-desktop a:hover, .nav-desktop a.active { opacity: 1; }
  .nav-actions { display: flex; align-items: center; gap: 0.75rem; }
  .btn-search { background: #fff; border: none; border-radius: 6px; width: 38px; height: 38px; display: flex; align-items: center; justify-content: center; cursor: pointer; color: #000; }
  .btn-newsletter { background: #fff; color: #000; border: none; border-radius: 6px; padding: 0.5rem 1.2rem; font-family: 'Agdasima', sans-serif; font-size: 1rem; font-weight: 700; text-decoration: none; cursor: pointer; white-space: nowrap; }
  .btn-hamburger { display: none; flex-direction: column; gap: 5px; background: none; border: none; cursor: pointer; padding: 4px; }
  .btn-hamburger span { display: block; width: 24px; height: 2px; background: #fff; border-radius: 2px; }
  .nav-mobile { display: none; flex-direction: column; background: #000; border-top: 1px solid #1a1a1a; padding: 1rem 1.5rem; gap: 0; }
  .nav-mobile.open { display: flex; }
  .nav-mobile a { color: #fff; text-decoration: none; font-size: 1.2rem; padding: 0.75rem 0; border-bottom: 1px solid #1a1a1a; font-family: 'Agdasima', sans-serif; }
  .nav-mobile .btn-newsletter { margin-top: 1rem; text-align: center; border-bottom: none; }
  @media (max-width: 768px) { .header-inner { grid-template-columns: auto 1fr; } .nav-desktop { display: none; } .nav-actions { display: none; } .btn-hamburger { display: flex; } }
</style>
