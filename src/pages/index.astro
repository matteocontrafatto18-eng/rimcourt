---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import GameCard from '../components/GameCard.astro';

// Data italiana corrente (SSR: calcolata ad ogni richiesta)
const now = new Date();
const formatter = new Intl.DateTimeFormat('sv-SE', { timeZone: 'Europe/Rome' });
const oggiIT = formatter.format(now);

// Fetchiamo 7 giorni da oggi
const dates: string[] = [];
for (let i = 0; i < 7; i++) {
  const d = new Date(now);
  d.setDate(d.getDate() + i);
  dates.push(formatter.format(d));
}
const datesQuery = dates.map(d => `dates[]=${d}`).join('&');

let partite: any[] = [];
let erroreAPI = false;
let erroreMsg = '';

try {
  const apiKey = import.meta.env.BALLDONTLIE_API_KEY ?? process.env.BALLDONTLIE_API_KEY;
  const url = `https://api.balldontlie.io/v1/games?${datesQuery}&per_page=100`;
  const res = await fetch(url, {
    headers: { Authorization: apiKey ?? '' }
  });
  if (res.ok) {
    const json = await res.json();
    partite = (json.data ?? []).sort((a: any, b: any) =>
      new Date(a.datetime ?? a.status).getTime() - new Date(b.datetime ?? b.status).getTime()
    );
  } else {
    erroreMsg = `API ${res.status}: ${await res.text()}`;
    erroreAPI = true;
  }
} catch (e: any) {
  erroreMsg = e?.message ?? 'fetch error';
  erroreAPI = true;
}

function oraIT(game: any): string {
  if (game.status === 'Final') return 'Final';
  if (game.period > 0) return `Q${game.period}${game.time ? ' ' + game.time : ''}`;
  const raw = game.datetime ?? game.status;
  if (!raw) return '–';
  const d = new Date(raw);
  if (isNaN(d.getTime())) return raw;
  return d.toLocaleTimeString('it-IT', {
    timeZone: 'Europe/Rome',
    hour: '2-digit',
    minute: '2-digit',
  });
}

function dataIT(game: any): string {
  const raw = game.datetime ?? game.status;
  if (!raw) return oggiIT;
  const d = new Date(raw);
  if (isNaN(d.getTime())) return oggiIT;
  return formatter.format(d);
}

function labelData(dateStr: string): string {
  if (dateStr === oggiIT) return 'Oggi';
  const domani = formatter.format(new Date(now.getTime() + 86400000));
  if (dateStr === domani) return 'Dom.';
  const d = new Date(dateStr + 'T12:00:00');
  return d.toLocaleDateString('it-IT', { day: 'numeric', month: 'short' });
}

const cluster = [
  { label: 'Dove vedere', href: '/dove-vedere' },
  { label: 'Recap & analisi', href: '/recap' },
  { label: 'Guide', href: '/guide' },
  { label: 'Squadre & giocatori', href: '/squadre' },
];
---

<Layout
  title="Rimcourt — NBA in italiano"
  description="Partite NBA di stasera, dove vederle in Italia, recap e analisi in italiano."
>
  <Header />

  <main class="mx-auto max-w-6xl px-6 py-8 space-y-8">

    <!-- Prossime partite -->
    <section aria-labelledby="partite-title">
      <div class="flex items-center justify-between mb-5">
        <h2
          id="partite-title"
          class="text-2xl font-bold text-white"
          style="font-family:'Agdasima',sans-serif;"
        >
          Prossime partite
        </h2>
        <a
          href="/partite"
          class="text-sm font-semibold text-orange-400 hover:text-orange-300 transition-colors"
          style="font-family:'Agdasima',sans-serif;"
        >
          Tutte →
        </a>
      </div>

      {erroreAPI ? (
        <p class="text-sm text-neutral-500">Dati non disponibili al momento.</p>
      ) : partite.length === 0 ? (
        <p class="text-sm text-neutral-500">Nessuna partita in programma.</p>
      ) : (
        /* Scroll orizzontale su mobile, griglia su desktop */
        <div class="flex gap-4 overflow-x-auto pb-2 snap-x snap-mandatory scrollbar-none
                    md:grid md:grid-cols-4 md:overflow-visible">
          {partite.map((p) => (
            <div class="snap-start">
              <GameCard
                game={p}
                dataLabel={labelData(dataIT(p))}
                ora={oraIT(p)}
                gameLabel={p.postseason ? 'Playoffs' : 'Regular Season'}
              />
            </div>
          ))}
        </div>
      )}
    </section>

    <!-- Recap e analisi -->
    <section aria-labelledby="recap-title" class="rounded-xl bg-neutral-900 border border-neutral-800 p-6">
      <div class="flex items-center justify-between mb-3">
        <h2
          id="recap-title"
          class="text-xl font-bold text-white"
          style="font-family:'Agdasima',sans-serif;"
        >
          Recap e analisi
        </h2>
        <a href="/recap" class="text-sm text-neutral-500 hover:text-neutral-300 transition-colors">Tutti →</a>
      </div>
      <p class="text-sm text-neutral-500">Il recap della notte in italiano — in arrivo.</p>
    </section>

    <!-- Esplora -->
    <section aria-labelledby="esplora-title">
      <h2
        id="esplora-title"
        class="mb-4 text-xs font-bold uppercase tracking-widest text-neutral-500"
        style="font-family:'Agdasima',sans-serif;"
      >
        Esplora
      </h2>
      <div class="grid grid-cols-2 gap-3 md:grid-cols-4">
        {cluster.map((c) => (
          <a
            href={c.href}
            class="rounded-xl border border-neutral-800 bg-neutral-900 px-4 py-8 text-base font-semibold text-neutral-300 transition-colors hover:border-orange-500 hover:text-white"
            style="font-family:'Agdasima',sans-serif;"
          >
            {c.label}
          </a>
        ))}
      </div>
    </section>

    <!-- Ads -->
    <div
      class="rounded-xl border border-dashed border-neutral-800 py-10 text-center text-xs text-neutral-700"
      aria-hidden="true"
    >
      spazio pubblicitario
    </div>

    <!-- Newsletter -->
    <section
      aria-labelledby="newsletter-title"
      class="flex flex-col sm:flex-row items-start sm:items-center gap-4 rounded-xl border border-neutral-800 bg-neutral-900 px-6 py-5"
    >
      <div class="flex-1">
        <h2
          id="newsletter-title"
          class="text-lg font-bold text-white"
          style="font-family:'Agdasima',sans-serif;"
        >
          Partite di stanotte + recap — nella tua inbox
        </h2>
        <p class="text-sm text-neutral-500 mt-1">Una mail al giorno, solo nei giorni di partita.</p>
      </div>
      <a
        href="/newsletter"
        class="shrink-0 rounded-md bg-orange-500 px-6 py-3 text-base font-bold text-white transition-colors hover:bg-orange-400"
        style="font-family:'Agdasima',sans-serif;"
      >
        Iscriviti
      </a>
    </section>

  </main>

  <!-- Footer -->
  <footer class="mt-12 border-t border-neutral-900 px-6 py-8">
    <div class="mx-auto max-w-6xl flex flex-wrap gap-6 text-sm text-neutral-600">
      <a href="/squadre" class="hover:text-neutral-300 transition-colors">Squadre</a>
      <a href="/giocatori" class="hover:text-neutral-300 transition-colors">Giocatori</a>
      <a href="/guide" class="hover:text-neutral-300 transition-colors">Guide</a>
      <a href="/dove-vedere" class="hover:text-neutral-300 transition-colors">Dove vedere NBA in Italia</a>
      <a href="/calendario" class="hover:text-neutral-300 transition-colors">Calendario 2026/27</a>
    </div>
  </footer>

</Layout>

<style>
  .scrollbar-none {
    scrollbar-width: none;
  }
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
</style>
