---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import StaseraInNba from '../components/sections/StaseraInNba';
import UltimePartite from '../components/sections/UltimePartite';
import HighlightsNotte from '../components/sections/HighlightsNotte';
import PrimaPagina from '../components/sections/PrimaPagina';
import { fetchUpcomingGames, fetchRecentGames } from '../lib/api';
import type { NewsArticle } from '../lib/types';

// Partite dall'API + contenuti curati, tutto in parallelo
const [upcomingGames, recentGames, newsEntries, nightlyEntries] = await Promise.all([
  fetchUpcomingGames().catch(() => []),
  fetchRecentGames().catch(() => []),
  getCollection('news', ({ data }) => !data.draft),
  getCollection('nightly'),
]);

// Notizie → ordina dalla più recente, mappa al formato del componente
const news: NewsArticle[] = newsEntries
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 4)
  .map((entry) => ({
    id: entry.id,
    title: entry.data.title,
    description: entry.data.description,
    imageUrl: entry.data.image || undefined,
    href: `/notizie/${entry.id}`,
    publishedAt: entry.data.publishedAt.toISOString(),
  }));

// Highlights → prende la giornata più recente
const latestNight = nightlyEntries.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
)[0];
const mvp = latestNight?.data.mvp;
const highlights = latestNight?.data.highlights ?? [];
---

<Layout
  title="Rimcourt — NBA in italiano"
  description="Partite NBA di stasera, dove vederle in Italia, recap e analisi in italiano."
>
  <Header />

  <main class="page-main">
    <StaseraInNba games={upcomingGames} client:load />
    <UltimePartite games={recentGames} client:load />
    <HighlightsNotte mvp={mvp} highlights={highlights} client:load />
    <PrimaPagina articles={news} client:load />
  </main>
</Layout>
